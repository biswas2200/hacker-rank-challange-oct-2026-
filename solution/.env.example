# Gemini runs on Vertex AI with Application Default Credentials; no API key.
# One-time setup:  gcloud auth application-default login
# Every value below is an optional override. The project defaults to the
# active gcloud project.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.6-flash
# USD per 1M tokens, used only for the cost estimate in usage_report.md.
# GEMINI_INPUT_PRICE_PER_M=0.75
# GEMINI_OUTPUT_PRICE_PER_M=3.75
